# Trinetra / OmniWatcher Backend Example Configuration
# Copy this to .env for local development or set in your deployment environment

# Server Binding
APP_API_HOST=0.0.0.0
APP_API_PORT=8000

# CORS Origins - Comma separated list of allowed frontend domains
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistent Data Storage
# When running in Docker, this should point to the mounted volume path
APP_DATA_DIR=/app/data
APP_CASE_DIR=/app/data/cases

# Security & API Keys
GROQ_API_KEY_1=<your_groq_api_key_here>

# Application Limits (Optional)
APP_STR_FILE_TTL_HOURS=24
APP_TOKEN_TTL_HOURS=12
APP_ALLOW_SIGNUP=1
APP_CORRELATION_WINDOW_SEC=3600
APP_INGEST_TIMEOUT_SEC=120
APP_PARSER_THREADS=4
APP_DETECT_MIN_CONFIDENCE=0.55
APP_ANOMALY_CONTAMINATION=0.05
APP_MAX_UPLOAD_FILES=50
