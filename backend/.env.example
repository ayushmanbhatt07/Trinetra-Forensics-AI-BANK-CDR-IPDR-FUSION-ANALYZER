# Runtime configuration.
# Copy to .env and adjust. Used by the API server.

# Backend
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost
APP_STR_FILE_TTL_HOURS=24

# LLM providers (OmniWatcher Groq backend).
# Keys live in backend/.env (gitignored) — put real values there, keep placeholders here.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Authentication (SECURITY: set a strong secret in production)
APP_SECRET=replace-with-a-long-random-string
APP_TOKEN_TTL_HOURS=12
APP_ALLOW_SIGNUP=1

# Frontend (baked at build time by Next.js).
# Leave NEXT_PUBLIC_API_URL unset when serving through nginx (same-origin /api).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js dev rewrite target for same-origin /api proxying (optional).
# APP_BACKEND_URL=http://localhost:8000
